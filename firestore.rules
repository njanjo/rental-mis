rules_version = '2';

// Rental MIS — baseline security rules.
// Trusted backend (Admin SDK) bypasses these rules; it must validate the actor
// and input independently. Test every collection in the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }

    function role() {
      return profile().role;
    }

    function isAdmin() {
      return activeUser() && role() == 'admin';
    }

    function isFinance() {
      return activeUser() && role() in ['admin', 'finance'];
    }

    function isAuditor() {
      return activeUser() && role() == 'auditor';
    }

    // Read-only visibility of the payment ledger and audit records.
    function canViewFinance() {
      return isFinance() || isAuditor();
    }

    function canViewAudit() {
      return isAdmin() || isAuditor();
    }

    function isOperations() {
      return activeUser() && role() in ['admin', 'property_manager'];
    }

    // Property-level scope. Admin sees everything; other roles are limited to
    // the propertyIds assigned on their profile.
    function inPropertyScope(propertyId) {
      return activeUser() && (
        isAdmin() || propertyId in profile().propertyIds
      );
    }

    match /users/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // provision roles via trusted backend only
    }

    match /properties/{id} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /tenants/{id} {
      allow read: if activeUser();
      allow write: if isOperations();
    }

    match /leases/{id} {
      allow read: if activeUser();
      allow write: if isOperations();
    }

    match /invoices/{id} {
      allow read: if activeUser();
      allow write: if false; // trusted reconciliation / billing jobs only
    }

    match /payments/{id} {
      allow read: if canViewFinance();
      allow write: if false;
    }

    match /paymentAllocations/{id} {
      allow read: if canViewFinance();
      allow write: if false;
    }

    match /unmatchedPayments/{id} {
      allow read: if canViewFinance();
      allow write: if false;
    }

    match /providerEvents/{id} {
      allow read, write: if false;
    }

    match /smsOutbox/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /smsLogs/{id} {
      allow read: if isFinance();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if canViewAudit();
      allow write: if false;
    }

    match /bankSyncRuns/{id} {
      allow read: if canViewFinance();
      allow write: if false;
    }

    match /maintenanceRequests/{id} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && role() in ['admin', 'property_manager', 'maintenance'];
      allow delete: if isAdmin();
    }

    match /systemSettings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
