# ---------------------------------------------------------------------------
# Firebase web config (safe to expose to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-rental-mis
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Connect the browser SDK to the Firebase Emulator Suite (never true in prod)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix with NEXT_PUBLIC_, never commit.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-rental-mis
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes when pasting a service-account private key.
FIREBASE_PRIVATE_KEY=

# Local only: route the Admin SDK at the emulators. Leave unset in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: App Check (enable once legitimate traffic is verified)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# FIREBASE_APPCHECK_DEBUG_TOKEN=

# ---------------------------------------------------------------------------
# Phase 5+ M-Pesa (Daraja). Leave blank to run the app without M-Pesa.
# ---------------------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# sandbox | production
MPESA_ENV=sandbox
# Public origin of this deployment, e.g. https://rental-mis.example.com —
# used as the base for the webhook URLs registered in the Daraja portal.
MPESA_CALLBACK_BASE_URL=
# Random path segment required by the callback routes (/api/mpesa/<stage>/<secret>).
# Generate with: openssl rand -hex 32 (need MPESA_CALLBACK_BASE_URL + this to
# register the validation, confirmation and STK callback URLs).
MPESA_CALLBACK_SECRET=

MPESA_CALLBACK_SECRET=

# Beam SMS bulk platform. Sender id max 11 alphanumeric characters (e.g. RENTMIS).
# Base URL may stay empty to use https://bulksms.beamnetworks.co.ke/api/v3.
# Delivery reports are polled from /sms/{uid}; there is no webhook.
BEAM_SMS_API_KEY=
BEAM_SMS_SENDER_ID=
BEAM_SMS_BASE_URL=

# Random path segment protecting the cron route (GET /api/cron/<secret>?job=drain|poll|reminders|all).
# Generate with: openssl rand -hex 32. Register a daily schedule with the scheduler.
CRON_SECRET=

BANK_WEBHOOK_SECRET=
